#!/bin/bash
set -euo pipefail

[[ ${1-} == -h || ${1-} == --help ]] && {
  cat <<'EOF'
usage: apply [-f] [-o] [tar]
  -f  fetch and extract even if frontend exists
  -o  open Chrome after patch

  default tar: /tmp/devtools-frontend.tar.zst
  dest: ~/.local/share/chromium
  Windows: %LOCALAPPDATA%/chromium

  needs: bash curl tar sed
  macOS tar has no zstd: brew install zstd
EOF
  exit
}

need() {
  command -v "$1" >/dev/null || {
    printf 'missing %s\n' "$1" >&2
    exit 1
  }
}

need tar
need sed

readonly repo='metaory/devtools-theme'
readonly artifact='devtools-frontend.tar.zst'

os=$(uname -s)
dest="$HOME/.local/share/chromium"
frontend="file://$dest/front_end"

case $os in
MINGW* | MSYS* | CYGWIN*)
  dest=${LOCALAPPDATA:-$HOME/AppData/Local}/chromium
  dest=${dest//\\//}
  command -v cygpath >/dev/null && dest=$(cygpath -m "$dest")
  if [[ $dest == [A-Za-z]:* ]]; then
    frontend="file:///$dest/front_end"
  else
    frontend="file://$dest/front_end"
  fi
  ;;
esac

readonly tokens="$dest/front_end/design_system_tokens.css"
readonly common="$dest/front_end/ui/legacy/inspectorCommon.css.js"

fetch='' open='' path=''
root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

while [[ $# -gt 0 ]]; do
  case $1 in
  -f | --fetch) fetch=1 ;;
  -o | --open) open=1 ;;
  *) path=$1 ;;
  esac
  shift
done

tar=${path:-${TMPDIR:-/tmp}/$artifact}

function extract {
  local stage
  mkdir -p "$dest"
  stage=$(mktemp -d "$dest/.front_end.XXXXXX")
  if tar -xaf "$tar" -C "$stage" 2>/dev/null; then
    :
  elif command -v zstd >/dev/null && zstd -dc "$tar" | tar -xf - -C "$stage"; then
    :
  else
    rm -rf "$stage"
    printf 'need zstd, or a tar that reads .zst\n' >&2
    exit 1
  fi

  # CLEAN
  [[ -f $stage/front_end/design_system_tokens.css &&
    -f $stage/front_end/ui/legacy/inspectorCommon.css.js ]] || {
    rm -rf "$stage"
    printf 'archive has no DevTools frontend\n' >&2
    exit 1
  }

  # EXTRACT
  rm -rf "$dest/front_end"
  mv "$stage/front_end" "$dest/front_end"
  [[ ! -f $stage/LICENSE ]] || mv "$stage/LICENSE" "$dest/LICENSE"
  rm -rf "$stage"
  printf 'extract %s\n' "$dest"
}

# FETCH
if [[ ${fetch-} || ! -f $tokens ]]; then
  [[ ${fetch-} || -s $tar || ! ${path-} ]] || {
    printf 'missing archive: %s\n' "$tar" >&2
    exit 1
  }
  [[ ${fetch-} || ! -s $tar ]] && {
    need curl
    printf 'download %s\n' "$tar"
    curl -fsSL -o "$tar" \
      "https://github.com/$repo/releases/latest/download/$artifact"
  }
  extract
fi

# TOKENS
sed -e '/\/\* === config.css === \*\//,$d' \
  -e '/\/\* === theme.css === \*\//,$d' \
  "$tokens" >"$tokens.tmp"
mv "$tokens.tmp" "$tokens"
bash "$root/scripts/overlay.sh" >>"$tokens"

# COMMON
last=$(tail -n1 "$common")
sed -e '/\/\* === inspector.css === \*\//,$d' \
  -e '/sourceURL/d' \
  "$common" >"$common.tmp"
mv "$common.tmp" "$common"
{
  bash "$root/scripts/overlay.sh" inspector.css
  printf '%s\n' "$last"
} >>"$common"

# BROWSER
browser=
for b in chromium google-chrome google-chrome-stable \
  '/Applications/Google Chrome.app/Contents/MacOS/Google Chrome' \
  '/c/Program Files/Google/Chrome/Application/chrome.exe' \
  '/c/Program Files (x86)/Google/Chrome/Application/chrome.exe'; do
  command -v "$b" >/dev/null && {
    browser=$b
    break
  }
  [[ -x "$b" ]] && {
    browser=$b
    break
  }
done
browser=${browser:-chromium}

printf 'theme %s\n%s --custom-devtools-frontend="%s"\n' \
  "$tokens" "$browser" "$frontend"

function chrome_running {
  command -v pgrep >/dev/null || return 1
  pgrep -x chromium >/dev/null ||
    pgrep -x chrome >/dev/null ||
    pgrep -x google-chrome >/dev/null ||
    pgrep -x google-chrome-stable >/dev/null ||
    pgrep -x 'Google Chrome' >/dev/null
}

if chrome_running; then
  printf 'quit Chrome and relaunch, or it ignores extra flags\n'
elif [[ ${open-} ]]; then
  exec "$browser" --custom-devtools-frontend="$frontend"
fi
