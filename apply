#!/usr/bin/env bash
# shellcheck disable=SC2154
#
set -euo pipefail

n=$'\033[0m'
for i in {0..7}; do
  printf -v "c$i" '\033[3%sm' "$i"
  printf -v "c$((i + 8))" '\033[1;9%sm' "$i"
done

fill() { printf "${c8}%0.s${1:-─}${n}" $(seq "$(tput cols 2>/dev/null || echo 80)"); }
say() { k=c$1 && printf ">\033[38;5;205m %s${3:+:}${!k}%s${n}\n" "$2" "${3:+ $3}" >&2; }

need() {
  command -v "$1" >/dev/null || {
    say 1 missing "$1"
    exit 1
  }
}

declare root fetch open path want_help os
declare dest="$HOME/.local/share/chromium"
declare frontend="file://$dest/front_end"

readonly repo='metaory/devtools-theme'
readonly artifact='devtools-frontend.tar.zst'

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
os=$(uname -s)

case $os in
MINGW* | MSYS* | CYGWIN*)
  dest=${LOCALAPPDATA:-$HOME/AppData/Local}/chromium
  dest=${dest//\\//}
  command -v cygpath >/dev/null && dest=$(cygpath -m "$dest")
  if [[ $dest == [A-Za-z]:* ]]; then
    frontend="file:///$dest/front_end"
  else
    frontend="file://$dest/front_end"
  fi
  ;;
esac

readonly tokens="$dest/front_end/design_system_tokens.css"
readonly common="$dest/front_end/ui/legacy/inspectorCommon.css.js"

while [[ $# -gt 0 ]]; do
  case $1 in
  -h | --help) want_help=1 ;;
  -f | --fetch) fetch=1 ;;
  -o | --open) open=1 ;;
  *) path=$1 ;;
  esac
  shift
done

tar=${path:-${TMPDIR:-/tmp}/$artifact}

cat <<EOF
${c6} apply ${c2}[-h] [-f] [-o] [tar]

${c3}        -h${n}          print usage and exit
${c3}        -f${n}          fetch even if exists
${c3}        -o${n}          open browser after patch
$(fill)
${c2}  apply${n}             overlay, fetch if needed
${c2}  apply <tar>${n}       extract this archive if needed
${c2}  apply -f -o <tar>${n} fetch to path, extract, open
$(fill)
EOF

say 3 tar "$tar"
say 3 dest "$dest"

fill

[[ $os == Darwin ]] && say 3 note 'macOS tar needs zstd: brew install zstd'

[[ ${want_help-} ]] && exit 0

for x in curl tar sed; do need "$x"; done

function download {
  [[ -s $tar ]] && say 3 overwrite "$tar"
  say 6 download "$tar"
  curl -fL --progress-bar -o "$tar" \
    "https://github.com/$repo/releases/latest/download/$artifact"
}

function extract {
  local stage
  mkdir -p "$dest"
  stage=$(mktemp -d "$dest/.front_end.XXXXXX")
  if tar -xaf "$tar" -C "$stage" 2>/dev/null; then
    :
  elif command -v zstd >/dev/null && zstd -dc "$tar" | tar -xf - -C "$stage"; then
    :
  else
    rm -rf "$stage"
    say 1 need 'zstd, or a tar that reads .zst'
    exit 1
  fi

  [[ -f $stage/front_end/design_system_tokens.css &&
    -f $stage/front_end/ui/legacy/inspectorCommon.css.js ]] || {
    rm -rf "$stage"
    say 1 archive 'has no DevTools frontend'
    exit 1
  }

  rm -rf "$dest/front_end"
  mv "$stage/front_end" "$dest/front_end"
  [[ ! -f $stage/LICENSE ]] || mv "$stage/LICENSE" "$dest/LICENSE"
  rm -rf "$stage"
  say 2 extract "$dest"
}

function pull {
  [[ ${fetch-} || ! -f $tokens ]] || {
    say 2 skip fetch
    [[ -s $tar ]] && say 6 unused "$tar"
    return
  }
  [[ ${fetch-} || -s $tar || ! ${path-} ]] || {
    say 1 'missing archive' "$tar"
    exit 1
  }
  [[ -f $tokens ]] && say 3 replace frontend
  dl=
  [[ ${fetch-} || ! -s $tar ]] && dl=1
  [[ $dl ]] && download
  [[ $dl ]] || say 6 using "$tar"
  extract
}

pull

fill

sed -e '/\/\* === config.css === \*\//,$d' \
  -e '/\/\* === theme.css === \*\//,$d' \
  "$tokens" >"$tokens.tmp"
mv "$tokens.tmp" "$tokens"
bash "$root/scripts/overlay.sh" >>"$tokens"

last=$(tail -n1 "$common")
sed -e '/\/\* === inspector.css === \*\//,$d' \
  -e '/sourceURL/d' \
  "$common" >"$common.tmp"
mv "$common.tmp" "$common"
{
  bash "$root/scripts/overlay.sh" inspector.css
  printf '%s\n' "$last"
} >>"$common"

say 5 theme "$tokens"

fill

browser=
for b in chromium google-chrome google-chrome-stable \
  '/Applications/Google Chrome.app/Contents/MacOS/Google Chrome' \
  '/c/Program Files/Google/Chrome/Application/chrome.exe' \
  '/c/Program Files (x86)/Google/Chrome/Application/chrome.exe'; do
  command -v "$b" >/dev/null && {
    browser=$b
    break
  }
  [[ -x "$b" ]] && {
    browser=$b
    break
  }
done

[[ $browser ]] || {
  say 3 no 'Chrome/Chromium binary found'
  say 6 'Brave/Edge/…:' "launch with --custom-devtools-frontend=\"$frontend\""
  exit 0
}

echo 'open with'
say 4 "$browser --custom-devtools-frontend=\"$frontend\""

function browser_running {
  command -v pgrep >/dev/null || return 1
  pgrep -x chromium >/dev/null ||
    pgrep -x chrome >/dev/null ||
    pgrep -x google-chrome >/dev/null ||
    pgrep -x google-chrome-stable >/dev/null ||
    pgrep -x 'Google Chrome' >/dev/null
}

[[ ${open-} ]] || exit 0

if browser_running; then
  say 3 quit 'the browser and relaunch, or it ignores extra flags'
  exit 0
fi

say 2 open "$browser"
exec "$browser" --custom-devtools-frontend="$frontend"

# vim: ft=bash
